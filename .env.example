# .env.example — modelo das variáveis de ambiente do GreenER
#
# Uso: na raiz do repositório, copie para `.env` (`cp .env.example .env`) antes de
# `docker compose up --build`. O `.env` é ignorado pelo Git (.gitignore) e não pode
# ser versionado. Os valores abaixo são EXEMPLOS de desenvolvimento: não valem para
# todo ambiente e precisam ser revistos em cada instalação real. Nenhum segredo de
# produção entra aqui (RP06).

# Backend
# Porta HTTP em que a API do backend atende.
PORT=3000

# Conexão do PostgreSQL usada pelo pool do driver `pg` (sem ORM — RP03/BD02).
# Depende do banco, das credenciais e do host do ambiente: fora do Docker o banco
# atende em localhost; dentro de um container `localhost` aponta para o próprio
# container, então o host precisa ser o nome do serviço (ex.: postgres). Confira
# usuário, senha, porta e nome do banco antes de subir.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/greener_db

# Base da API auxiliar; padrão oficial. Sem credenciais, query ou fragmento.
CARBON_API_URL=https://carbon.unilaunch.org

# Chave que assina os tokens JWT da área de configuração (DW06/RP06).
# Segredo de fábrica, só para desenvolvimento; para gerar outro:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-secret-change-me

# Validade do token emitido no login, no formato da biblioteca jsonwebtoken
# (ex.: 8h, 7d). Sem refresh token no MVP: expirado, o usuário faz login de novo.
JWT_EXPIRES_IN=8h

# API agregadora de métricas (UniLaunch) consultada pelo backend; padrão se vazio: https://metrics.unilaunch.org
METRICS_API_URL=https://metrics.unilaunch.org
# Dispatcher de descoberta e intervalo inicial/de recuperação (ms, inteiro de 1 a 2147483647).
# Prazo válido vem de collection_interval_seconds; não é polling da tela.
POLLING_INTERVAL_MS=30000

# Frontend
# Base da API vista pelo NAVEGADOR (por isso localhost, e não o nome do serviço no compose).
# É embutida no bundle no build: depois de mudar, rode docker compose up --build. Vazia = modo demonstração.
VITE_API_URL=http://localhost:3000/api
