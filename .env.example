# .env.example — modelo das variáveis de ambiente do EcoPulse
#
# Uso: na raiz do repositório, copie para `.env` (`cp .env.example .env`) antes de
# `docker compose up --build`. O `.env` é ignorado pelo Git (.gitignore) e não pode
# ser versionado. Os valores abaixo são EXEMPLOS de desenvolvimento: não valem para
# todo ambiente e precisam ser revistos em cada instalação real. Nenhum segredo de
# produção entra aqui (RP06).

# PostgreSQL (serviço `postgres` do compose.yaml)
# Credenciais criadas na primeira subida do volume `pgdata`. Depois de criado, mudar
# aqui não altera o banco existente: zere com `docker compose down -v`. Use só letras
# e números na senha, porque ela entra na DATABASE_URL que o compose monta para o backend.
POSTGRES_USER=ecopulse
POSTGRES_PASSWORD=ecopulse
POSTGRES_DB=ecopulse_db
# Porta do host em que o banco fica acessível (psql, DBeaver, backend fora do Docker).
# Dentro do compose o banco atende sempre em postgres:5432. Se a 5432 da máquina já
# estiver livre e você preferir, pode usar 5432. O exemplo usa 5433 para não conflitar com
# um PostgreSQL instalado localmente.
POSTGRES_HOST_PORT=5433

# Backend
# Porta HTTP em que a API do backend atende. Só vale fora do Docker: no compose o
# backend atende sempre na 3000.
PORT=3000

# Conexão do PostgreSQL usada pelo pool do driver `pg` (sem ORM — RP03/BD02).
# Depende do banco, das credenciais e do host do ambiente: fora do Docker o banco
# atende em localhost; dentro de um container `localhost` aponta para o próprio
# container, então o host precisa ser o nome do serviço (ex.: postgres). Confira
# usuário, senha, porta e nome do banco antes de subir. No `docker compose up` este
# valor é ignorado: o compose monta a URL do backend com POSTGRES_* e o host `postgres`.
# Ele vale para rodar o backend fora do Docker contra o banco do compose: use as
# mesmas credenciais de POSTGRES_* e a porta de POSTGRES_HOST_PORT.
DATABASE_URL=postgresql://ecopulse:ecopulse@localhost:5433/ecopulse_db

# Base da API auxiliar; padrão oficial se vazia. Sem credenciais, query ou fragmento.
CARBON_API_URL=https://carbon.unilaunch.org

# Chave que assina os tokens JWT da área de configuração (DW06/RP06).
# Obrigatória para o backend iniciar; use ao menos 16 caracteres.
# Segredo de exemplo, só para desenvolvimento; para gerar outro:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-secret-change-me

# Validade do token emitido no login, no formato da biblioteca jsonwebtoken
# (ex.: 8h, 7d). Sem refresh token no MVP: expirado, o usuário faz login de novo.
JWT_EXPIRES_IN=8h

# API agregadora de métricas (UniLaunch) consultada pelo backend; padrão se vazio: https://metrics.unilaunch.org
METRICS_API_URL=https://metrics.unilaunch.org
# Dispatcher de descoberta e intervalo inicial/de recuperação (ms, inteiro de 1 a 2147483647).
# Prazo válido vem de collection_interval_seconds; não é polling da tela.
# O compose ainda não repassa esta variável ao container: no Docker vale o padrão de 30000.
POLLING_INTERVAL_MS=30000
# Origem(ns) do frontend que o navegador pode usar para chamar a API (CORS), separadas por vírgula.
# Protocolo, host e porta, sem caminho. Precisa bater com o endereço aberto no navegador.
CORS_ORIGIN=http://localhost:5173

# Frontend
# Base da API vista pelo NAVEGADOR (por isso localhost, e não o nome do serviço no compose).
# É embutida no bundle no build: depois de mudar, rode docker compose up --build. Vazia = modo demonstração.
VITE_API_URL=http://localhost:3000/api
# Intervalo da atualização automática do dashboard, em milissegundos (mínimo 5000)
VITE_REFRESH_INTERVAL_MS=30000
