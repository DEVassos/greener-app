# .env.example

# Backend
PORT=3000
DATABASE_URL=postgresql://usuario:senha@localhost:5432/greener_db
# Base da API auxiliar; padrão oficial. Sem credenciais, query ou fragmento.
CARBON_API_URL=https://carbon.unilaunch.org
JWT_SECRET=sua_chave_secreta_aqui
# API agregadora de métricas (UniLaunch) consultada pelo backend; padrão se vazio: https://metrics.unilaunch.org
METRICS_API_URL=https://metrics.unilaunch.org

# Frontend
# Base da API vista pelo NAVEGADOR (por isso localhost, e não o nome do serviço no compose).
# É embutida no bundle no build: depois de mudar, rode docker compose up --build. Vazia = modo demonstração.
VITE_API_URL=http://localhost:3000/api
