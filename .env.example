# Copie para .env e ajuste. Nunca versione o .env com valores reais.

# --- frontend ---
# Endereço base da API do backend usado pelo navegador (frontend/src/services/api.ts).
# Sem ela o frontend roda em modo demonstração, com dados ilustrativos.
VITE_API_URL=http://localhost:3000
# Intervalo da atualização automática do dashboard, em milissegundos (mínimo 5000)
VITE_REFRESH_INTERVAL_MS=30000
